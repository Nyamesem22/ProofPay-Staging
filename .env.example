# Public application configuration
VITE_API_MODE=auto
VITE_ALLOW_LOCAL_DEMO=true
VITE_ENABLE_ADMIN_DEMO=true
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# Neon PostgreSQL (use the pooled connection string for Vercel Functions)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Authentication and cookies
SESSION_COOKIE_NAME=proofpay_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Distributed rate limiting and cache (Upstash REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private evidence storage (Vercel Blob; OIDC is preferred on new stores)
BLOB_READ_WRITE_TOKEN=

# Payment and identity partners. Keep disabled until licensed contracts and keys exist.
PAYMENTS_ENABLED=false
PRIMARY_PAYMENT_PROVIDER=hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ITC_API_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
ONAFRIQ_API_KEY=
CELLULANT_API_KEY=
NIA_IVSP_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=info
